+import { Router } from 'express';
+import { createOrderReview, getRestaurantReviews } from '../controllers/reviewController.js';
+import { validateCreateReview } from '../validators/review.validator.js';
+import { validateIdParam } from '../validators/menu.validator.js';
+import auth from '../middleware/auth.js';
+import { allowRoles } from '../middleware/role.js';
+
+// Mounted at /api/v1/orders  ->  POST /:id/review
+export const orderReviewRouter = Router();
+orderReviewRouter.post(
