diff --git a/src/services/review.service.js b/src/services/review.service.js
new file mode 100644
index 0000000..00fecf5
--- /dev/null
+++ b/src/services/review.service.js
@@ -0,0 +1,99 @@
+import Order from '../models/Order.js';
+import Restaurant from '../models/Restaurant.js';
+import Review from '../models/Review.js';
+import ApiError from '../utils/ApiError.js';
+
+// A customer reviews one of their own delivered orders.
+// The restaurant always comes from the order, never from the client.
+export const createReview = async (userId, orderId, { rating, comment = '' }) => {
+  const order = await Order.findById(orderId);
+
+  if (!order) throw new ApiError(404, 'Order not found.');
+
+  if (String(order.user) !== String(userId)) {
+    throw new ApiError(403, 'You can only review your own orders.');
+  }
+
+  if (order.status !== 'delivered') {
+    throw new ApiError(400, 'Only delivered orders can be reviewed.');
+  }
+
+  if (await Review.findOne({ order: order._id })) {
+    throw new ApiError(409, 'You have already reviewed this order.');
+  }
+
+  try {
+    return await Review.create({
+      order: order._id,
+      user: userId,
+      restaurant: order.restaurant,
+      rating,
+      comment,
+    });
+  } catch (error) {
+    // Two requests at the same time: the unique index on `order` catches it
+    if (error?.code === 11000) {
+      throw new ApiError(409, 'You have already reviewed this order.');
+    }
+    throw error;
+  }
+};
+
+// Public list of an approved restaurant's reviews, newest first.
+export const listRestaurantReviews = async (restaurantId, { page, limit }) => {
+  const restaurant = await Restaurant.findOne({
+    _id: restaurantId,
+    status: 'approved',
+  });
+
+  if (!restaurant) throw new ApiError(404, 'Restaurant not found.');
+
+  const [reviews, total, summaries] = await Promise.all([
+    Review.find({ restaurant: restaurant._id })
+      .sort({ createdAt: -1 })
+      .skip((page - 1) * limit)
+      .limit(limit)
+      .populate('user', 'name') // name only: never email or password hash
+      .select('rating comment user createdAt'),
+    Review.countDocuments({ restaurant: restaurant._id }),
+    getRatingSummaries([restaurant._id]),
+  ]);
+
+  const summary = summaries.get(String(restaurant._id)) ?? EMPTY_SUMMARY;
+
+  return { reviews, total, page, limit, ...summary };
+};
+
+const EMPTY_SUMMARY = { averageRating: null, reviewCount: 0 };
+
+// Returns Map<restaurantId, { averageRating, reviewCount }> for many restaurants
+// in one query. Restaurants with no reviews are not in the map.
+export const getRatingSummaries = async (restaurantIds) => {
+  if (restaurantIds.length === 0) return new Map();
+
+  const rows = await Review.aggregate([
+    { $match: { restaurant: { $in: restaurantIds } } },
+    {
+      $group: {
+        _id: '$restaurant',
+        average: { $avg: '$rating' },
+        count: { $sum: 1 },
+      },
+    },
+  ]);
+
+  return new Map(
+    rows.map((row) => [
+      String(row._id),
+      {
+        averageRating: Math.round(row.average * 10) / 10,
+        reviewCount: row.count,
+      },
+    ])
+  );
+};
+
+export const withRatingSummary = (restaurant, summaries) => ({
+  ...restaurant.toObject(),
+  ...(summaries.get(String(restaurant._id)) ?? EMPTY_SUMMARY),
+});
diff --git a/src/validators/review.validator.js b/src/validators/review.validator.js
new file mode 100644
index 0000000..0df90e1
--- /dev/null
+++ b/src/validators/review.validator.js
@@ -0,0 +1,31 @@
+import ApiError from '../utils/ApiError.js';
+
+const MAX_COMMENT = 500;
+
+// Checks the body of POST /orders/:id/review.
+// Collects every problem and passes a single 400 to the error handler.
+export const validateCreateReview = (req, res, next) => {
+  const body = req.body ?? {};
+  const errors = [];
+
+  if (!Number.isInteger(body.rating) || body.rating < 1 || body.rating > 5) {
+    errors.push('rating must be a whole number from 1 to 5');
+  }
+
+  if (body.comment !== undefined && body.comment !== null) {
+    if (typeof body.comment !== 'string') {
+      errors.push('comment must be text');
+    } else if (body.comment.trim().length > MAX_COMMENT) {
+      errors.push(`comment must be at most ${MAX_COMMENT} characters`);
+    }
+  }
+
+  if (errors.length) return next(new ApiError(400, 'Validation failed', errors));
+
+  // Keep only the fields we accept, so extras (user, restaurant) are ignored
+  req.body = {
+    rating: body.rating,
+    comment: typeof body.comment === 'string' ? body.comment.trim() : '',
+  };
+  return next();
+};
diff --git a/test/review.test.js b/test/review.test.js
new file mode 100644
index 0000000..7c3da01
--- /dev/null
+++ b/test/review.test.js
@@ -0,0 +1,93 @@
+import assert from 'node:assert/strict';
+import { once } from 'node:events';
+import { test, mock, afterEach } from 'node:test';
+import app from '../src/app.js';
+import Order from '../src/models/Order.js';
+import Review from '../src/models/Review.js';
+import Restaurant from '../src/models/Restaurant.js';
+import { createReview, getRatingSummaries, listRestaurantReviews } from '../src/services/review.service.js';
+import { validateCreateReview } from '../src/validators/review.validator.js';
+
+afterEach(() => mock.restoreAll());
+
+const ID = '64b7f0c2a1b2c3d4e5f60718';
+const USER = '64b7f0c2a1b2c3d4e5f60001';
+const run = (body) => {
+  const req = { body };
+  let err;
+  validateCreateReview(req, {}, (e) => { err = e; });
+  return { req, err };
+};
+
+test('validator accepts a good review and strips extra fields', () => {
+  const { req, err } = run({ rating: 5, comment: '  Great  ', user: 'x', restaurant: 'y' });
+  assert.equal(err, undefined);
+  assert.deepEqual(req.body, { rating: 5, comment: 'Great' });
+});
+
+test('validator rejects bad ratings and long comments', () => {
+  for (const rating of [0, 6, 3.5, '4', undefined, null]) {
+    assert.equal(run({ rating }).err.statusCode, 400, `rating ${rating}`);
+  }
+  assert.equal(run({ rating: 4, comment: 'a'.repeat(501) }).err.statusCode, 400);
+  assert.equal(run({ rating: 4, comment: 42 }).err.statusCode, 400);
+  assert.equal(run({ rating: 4 }).err, undefined);
+});
+
+test('createReview: 404, 403, 400, 409 rules', async () => {
+  const order = (over) => ({ _id: ID, user: USER, restaurant: 'rest1', status: 'delivered', ...over });
+
+  mock.method(Order, 'findById', async () => null);
+  await assert.rejects(createReview(USER, ID, { rating: 5 }), { statusCode: 404 });
+
+  mock.method(Order, 'findById', async () => order({ user: 'someone-else' }));
+  await assert.rejects(createReview(USER, ID, { rating: 5 }), { statusCode: 403 });
+
+  mock.method(Order, 'findById', async () => order({ status: 'pending' }));
+  await assert.rejects(createReview(USER, ID, { rating: 5 }), { statusCode: 400 });
+
+  mock.method(Order, 'findById', async () => order());
+  mock.method(Review, 'findOne', async () => ({ _id: 'existing' }));
+  await assert.rejects(createReview(USER, ID, { rating: 5 }), { statusCode: 409 });
+});
+
+test('createReview: restaurant comes from the order; race maps to 409', async () => {
+  mock.method(Order, 'findById', async () => ({ _id: ID, user: USER, restaurant: 'rest-from-order', status: 'delivered' }));
+  mock.method(Review, 'findOne', async () => null);
+  const create = mock.method(Review, 'create', async (doc) => doc);
+
+  const review = await createReview(USER, ID, { rating: 4, comment: 'ok' });
+  assert.equal(review.restaurant, 'rest-from-order');
+  assert.equal(create.mock.calls[0].arguments[0].user, USER);
+
+  create.mock.restore();
+  mock.method(Review, 'create', async () => { throw Object.assign(new Error('dup'), { code: 11000 }); });
+  await assert.rejects(createReview(USER, ID, { rating: 4 }), { statusCode: 409 });
+});
+
+test('listRestaurantReviews: 404 for unapproved/missing restaurant', async () => {
+  mock.method(Restaurant, 'findOne', async () => null);
+  await assert.rejects(listRestaurantReviews(ID, { page: 1, limit: 10 }), { statusCode: 404 });
+});
+
+test('getRatingSummaries rounds to one decimal and handles empty input', async () => {
+  assert.equal((await getRatingSummaries([])).size, 0);
+  mock.method(Review, 'aggregate', async () => [{ _id: 'r1', average: 4.3333, count: 3 }]);
+  const map = await getRatingSummaries(['r1']);
+  assert.deepEqual(map.get('r1'), { averageRating: 4.3, reviewCount: 3 });
+});
+
+test('review routes: auth and id checks', async (t) => {
+  const server = app.listen(0, '127.0.0.1');
+  await once(server, 'listening');
+  t.after(() => new Promise((res, rej) => server.close((e) => (e ? rej(e) : res()))));
+  const base = `http://127.0.0.1:${server.address().port}`;
+
+  const noToken = await fetch(`${base}/api/v1/orders/${ID}/review`, {
+    method: 'POST', headers: { 'content-type': 'application/json' }, body: '{"rating":5}',
+  });
+  assert.equal(noToken.status, 401);
+
+  const badId = await fetch(`${base}/api/restaurants/not-an-id/reviews`);
+  assert.equal(badId.status, 400);
+});
-- 
